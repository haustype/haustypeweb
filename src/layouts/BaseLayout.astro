---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Screensaver from '../components/Screensaver.astro';
import SiteFloatingControls from '../components/SiteFloatingControls.astro';
import { loadScreensaverOptions } from '../lib/screensaver-config';
import {
  buildDocumentTitle,
  faviconMimeType,
  loadSiteSettings,
} from '../lib/site-identity';
import {
  FONTDUE_UI_FONT_CSS,
  FONTDUE_UI_FONT_PRELOAD,
} from '../lib/fontdue-config';
import {
  jsonLdScript,
  organizationJsonLd,
  webSiteJsonLd,
  type JsonLd,
} from '../lib/json-ld';

interface Props {
  /** Page-specific title; combined with the CMS title suffix unless fullTitle is set. */
  title?: string;
  /** Full document <title> override (homepage, 404, etc.). */
  fullTitle?: string;
  description?: string;
  image?: string;
  /** Optional extra JSON-LD nodes merged into the page graph. */
  jsonLd?: JsonLd;
  preloadImages?: string[];
  buyCollectionId?: string;
  trialFontsHref?: string;
}

const {
  title,
  fullTitle,
  description: descriptionProp,
  image: imageProp,
  jsonLd: extraJsonLd,
  preloadImages = [],
  buyCollectionId,
  trialFontsHref,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';

const { siteIdentity, customCode } = await loadSiteSettings();
const customHeadEnd = customCode.headEnd;
const customBodyEnd = customCode.bodyEnd;

const documentTitle =
  fullTitle?.trim() ||
  (isHome ? siteIdentity.homeTitle : title ? buildDocumentTitle(title, siteIdentity) : siteIdentity.siteName);

const description =
  descriptionProp?.trim() ||
  (isHome ? siteIdentity.homeDescription : '') ||
  siteIdentity.defaultDescription;
const shareImage = imageProp || siteIdentity.defaultShareImageUrl || undefined;
const shareImageUrl = shareImage ? new URL(shareImage, Astro.url).href : undefined;
const faviconType = siteIdentity.faviconUrl
  ? faviconMimeType(siteIdentity.faviconUrl)
  : undefined;
const twitterHandle = siteIdentity.twitterHandle
  ? siteIdentity.twitterHandle.replace(/^@/, '')
  : null;
const gaId = siteIdentity.googleAnalyticsId;

const siteOrigin = Astro.site?.origin ?? 'https://www.haustype.com';
const orgNode = organizationJsonLd({
  name: siteIdentity.siteName,
  url: siteOrigin,
  description: siteIdentity.defaultDescription,
  logoUrl: siteIdentity.faviconUrl
    ? new URL(siteIdentity.faviconUrl, Astro.url).href
    : null,
});
const websiteNode = webSiteJsonLd({
  name: siteIdentity.siteName,
  url: siteOrigin,
  description: siteIdentity.defaultDescription,
});
const extraNodes = extraJsonLd
  ? Array.isArray(extraJsonLd)
    ? extraJsonLd
    : [extraJsonLd]
  : [];
const structuredData = jsonLdScript([orgNode, websiteNode, ...extraNodes]);

const isBlog =
  Astro.url.pathname === '/blog' || Astro.url.pathname.startsWith('/blog/');
const is404Page = Astro.url.pathname === '/404';
const screensaver = !isBlog && !is404Page ? await loadScreensaverOptions() : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={siteIdentity.themeColor} />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {siteIdentity.faviconUrl && (
      <link
        rel="icon"
        href={new URL(siteIdentity.faviconUrl, Astro.url).href}
        {...(faviconType ? { type: faviconType } : {})}
      />
    )}
    {siteIdentity.appleTouchIconUrl && (
      <link rel="apple-touch-icon" href={siteIdentity.appleTouchIconUrl} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en" />
    <meta property="og:site_name" content={siteIdentity.siteName} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    <meta name="twitter:card" content={shareImageUrl ? 'summary_large_image' : 'summary'} />
    {twitterHandle && <meta name="twitter:site" content={`@${twitterHandle}`} />}
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
    <script type="application/ld+json" set:html={structuredData} />
    <link
      rel="preload"
      href={FONTDUE_UI_FONT_PRELOAD}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href={FONTDUE_UI_FONT_CSS} as="style" />
    <link rel="stylesheet" href={FONTDUE_UI_FONT_CSS} />
    <link rel="stylesheet" href="https://js.fontdue.com/fontdue.css" />
    {preloadImages.map((src) => (
      <link rel="preload" as="image" href={new URL(src, Astro.url).href} />
    ))}
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <script is:inline>
      try {
        var siteBg = localStorage.getItem('site-bg');
        var toggleRotation = 0;
        if (siteBg === 'dark') {
          document.documentElement.classList.add('site-bg-dark');
          toggleRotation = 120;
        } else if (siteBg === 'alt' || siteBg === 'yellow') {
          document.documentElement.classList.add('site-bg-yellow');
          toggleRotation = 240;
        }
        document.documentElement.style.setProperty(
          '--site-bg-toggle-rotation',
          toggleRotation + 'deg',
        );
      } catch (_) {}
      try {
        if (sessionStorage.getItem('reveal-once-done') === '1') {
          document.documentElement.classList.add('reveal-once-done');
        }
      } catch (_) {}
      document.documentElement.classList.add('reveal-pending');
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
    </script>
    <style is:inline>
      html.reveal-pending [data-reveal]:not(.is-revealed):not(.reveal-no-animation) {
        opacity: 0;
      }
      html.reveal-pending [data-reveal='up']:not(.is-revealed):not(.reveal-no-animation) {
        transform: translateY(14px);
      }
    </style>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    {customHeadEnd && <Fragment set:html={customHeadEnd} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <fontdue-store-modal></fontdue-store-modal>
    {screensaver && (
      <Screensaver
        slides={screensaver.slides}
        idleSeconds={screensaver.idleSeconds}
        slideSeconds={screensaver.slideSeconds}
        fadeSeconds={screensaver.fadeSeconds}
      />
    )}
    <div class="site-shell flex flex-1 flex-col w-full" id="main-content">
      <slot />
    </div>
    <Footer />
    <SiteFloatingControls buyCollectionId={buyCollectionId} trialFontsHref={trialFontsHref} />
    <script is:inline>
      window.addEventListener('pageshow', function (e) {
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          if (e.persisted || (nav && nav.type === 'back_forward')) return;
        } catch (_) {}
        window.scrollTo(0, 0);
      });
    </script>
    <script>
      import { scheduleFontdueInit } from '../lib/fontdue-init';
      import { initAllSlideshows } from '../lib/slideshow';
      import { initCharacterViewerStyles } from '../lib/fontdue-character-viewer';
      import { initStoreModalStyles } from '../lib/fontdue-store-modal';
      import { initTypeTesterStyles } from '../lib/fontdue-type-testers';
      import { initSiteBgToggle } from '../lib/site-bg';

      function initPageWidgets() {
        initSiteBgToggle();
        initAllSlideshows();
        initCharacterViewerStyles();
        initStoreModalStyles();
        initTypeTesterStyles();
      }

      scheduleFontdueInit();
      initPageWidgets();
    </script>
    <script>
      function initRevealAnimations() {
        const STAGGER_MS = 100;
        const STAGGER_CAP = 560;
        const scrollRevealScanners = [];
        const SCROLL_OBSERVER = {
          threshold: 0.18,
          rootMargin: '0px 0px -12% 0px',
        };
        const ROW_TOP_TOLERANCE_PX = 6;

        function getRowGroups(elements) {
          if (!elements.length) return [];

          const sorted = [...elements].sort(
            (a, b) => a.offsetTop - b.offsetTop || a.offsetLeft - b.offsetLeft,
          );
          const rows = [];
          let currentRow = [];
          let rowTop = null;

          for (const el of sorted) {
            const top = el.offsetTop;
            if (rowTop === null || Math.abs(top - rowTop) <= ROW_TOP_TOLERANCE_PX) {
              currentRow.push(el);
              rowTop = rowTop ?? top;
            } else {
              rows.push(currentRow);
              currentRow = [el];
              rowTop = top;
            }
          }

          if (currentRow.length) rows.push(currentRow);

          rows.forEach((row) => {
            row.sort((a, b) => a.offsetLeft - b.offsetLeft);
          });

          return rows;
        }

        function revealRowGroupsStaggered(rows, revealItem) {
          rows.forEach((row) => {
            row.forEach((el, i) => revealItem(el, i));
          });
        }

        const staggerGroups = Array.from(document.querySelectorAll('[data-reveal-stagger]'));
        const groupedEls = new Set();
        staggerGroups.forEach((group) => {
          group.querySelectorAll('[data-reveal]').forEach((el) => groupedEls.add(el));
        });

        const els = Array.from(document.querySelectorAll('[data-reveal]')).filter(
          (el) => !groupedEls.has(el),
        );

        if (!els.length && !staggerGroups.length) {
          document.documentElement.classList.remove('reveal-pending');
          return;
        }

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function getRowRevealState(anchor) {
          const rect = anchor.getBoundingClientRect();
          const bandBottom = window.innerHeight * 0.88;
          if (rect.bottom <= 0) return 'passed';
          if (rect.top >= bandBottom) return 'below';
          return 'visible';
        }

        /** Hold reveal until imgs inside [data-reveal-wait-images] are ready. */
        const IMAGE_WAIT_MS = 6000;
        const revealScheduled = new WeakSet();

        function waitForRevealImages(el) {
          if (!el.hasAttribute('data-reveal-wait-images')) return Promise.resolve();

          const images = Array.from(el.querySelectorAll('img'));
          if (!images.length) return Promise.resolve();

          return Promise.all(
            images.map((img) => {
              if (img.loading === 'lazy') img.loading = 'eager';
              if (img.complete && img.naturalHeight > 0) return Promise.resolve();
              return new Promise((resolve) => {
                const done = () => resolve();
                img.addEventListener('load', done, { once: true });
                img.addEventListener('error', done, { once: true });
                setTimeout(done, IMAGE_WAIT_MS);
              });
            }),
          );
        }

        function waitForRevealImagesAll(elements) {
          return Promise.all(elements.map((el) => waitForRevealImages(el)));
        }

        function paintRevealInstant(el) {
          if (el.classList.contains('is-revealed')) return;
          el.style.transitionDelay = '';
          el.classList.add('reveal-no-animation', 'is-revealed');
        }

        function paintRevealAnimated(el, delayIndex = 0) {
          if (el.classList.contains('is-revealed')) return;
          const delayMs = Math.min(delayIndex * STAGGER_MS, STAGGER_CAP);
          el.style.transitionDelay = delayMs + 'ms';
          el.classList.add('is-revealed');
          el.addEventListener(
            'transitionend',
            () => {
              el.style.transitionDelay = '';
            },
            { once: true },
          );
        }

        function revealInstant(el) {
          if (el.classList.contains('is-revealed') || revealScheduled.has(el)) return;
          revealScheduled.add(el);
          waitForRevealImages(el).then(() => paintRevealInstant(el));
        }

        function revealAnimated(el, delayIndex = 0) {
          if (el.classList.contains('is-revealed') || revealScheduled.has(el)) return;
          revealScheduled.add(el);
          waitForRevealImages(el).then(() => paintRevealAnimated(el, delayIndex));
        }

        function revealBatchAnimated(elements, delayForIndex) {
          const pending = elements.filter(
            (el) => !el.classList.contains('is-revealed') && !revealScheduled.has(el),
          );
          if (!pending.length) return;
          pending.forEach((el) => revealScheduled.add(el));
          waitForRevealImagesAll(pending).then(() => {
            pending.forEach((el, i) => paintRevealAnimated(el, delayForIndex(el, i)));
          });
        }

        function revealBatchInstant(elements) {
          const pending = elements.filter(
            (el) => !el.classList.contains('is-revealed') && !revealScheduled.has(el),
          );
          if (!pending.length) return;
          pending.forEach((el) => revealScheduled.add(el));
          waitForRevealImagesAll(pending).then(() => {
            pending.forEach((el) => paintRevealInstant(el));
          });
        }

        function applyRevealDelay(el, delayIndex, cap = true) {
          revealAnimated(el, cap ? delayIndex : Math.min(delayIndex, STAGGER_CAP / STAGGER_MS));
        }

        function revealStaggered(children, startIndex = 0) {
          revealBatchAnimated(children, (_el, i) => startIndex + i);
        }

        if (reduce) {
          waitForRevealImagesAll([
            ...els,
            ...staggerGroups.flatMap((group) =>
              Array.from(group.querySelectorAll('[data-reveal]')),
            ),
          ]).then(() => {
            els.forEach((el) => el.classList.add('is-revealed'));
            staggerGroups.forEach((group) => {
              group.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-revealed'));
            });
            document.documentElement.classList.remove('reveal-pending');
          });
          return;
        }

        const ONCE_KEY = 'reveal-once-done';
        let onceDone = false;
        try {
          onceDone = sessionStorage.getItem(ONCE_KEY) === '1';
        } catch (e) {}

        const vh = window.innerHeight;
        const inView = [];
        const belowFold = [];
        els.forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.95) {
            inView.push(el);
          } else {
            belowFold.push(el);
          }
        });

        let staggerIndex = 0;
        let animatedOnce = false;
        const toAnimate = [];
        inView.forEach((el) => {
          if (el.hasAttribute('data-reveal-once') && onceDone) {
            el.classList.add('reveal-no-animation', 'is-revealed');
            return;
          }
          if (el.hasAttribute('data-reveal-once')) animatedOnce = true;
          el.style.transitionDelay = Math.min(staggerIndex * STAGGER_MS, STAGGER_CAP) + 'ms';
          staggerIndex += 1;
          el.addEventListener(
            'transitionend',
            () => {
              el.style.transitionDelay = '';
            },
            { once: true }
          );
          toAnimate.push(el);
        });
        if (animatedOnce) {
          try {
            sessionStorage.setItem(ONCE_KEY, '1');
          } catch (e) {}
        }
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            toAnimate.forEach((el) => el.classList.add('is-revealed'));
          })
        );

        if (belowFold.length) {
          function scanPassedRevealEls() {
            belowFold.forEach((el) => {
              if (el.classList.contains('is-revealed')) return;
              if (el.getBoundingClientRect().bottom <= 0) revealInstant(el);
            });
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  e.target.classList.add('is-revealed');
                  observer.unobserve(e.target);
                }
              });
            },
            SCROLL_OBSERVER,
          );
          belowFold.forEach((el) => {
            el.classList.add('reveal-on-scroll');
            observer.observe(el);
          });
          scrollRevealScanners.push(scanPassedRevealEls);
        }

        staggerGroups.forEach((group) => {
          const children = Array.from(group.querySelectorAll('[data-reveal]'));
          if (!children.length) return;

          const scrollMode = group.getAttribute('data-reveal-stagger') === 'scroll';
          const inViewChildren = [];
          const belowFoldChildren = [];

          children.forEach((el) => {
            if (el.getBoundingClientRect().top < vh * 0.95) {
              inViewChildren.push(el);
            } else {
              belowFoldChildren.push(el);
            }
          });

          if (scrollMode) {
            const allRows = getRowGroups(children);

            if (inViewChildren.length) {
              const rows = getRowGroups(inViewChildren);
              const delayByEl = new Map();
              rows.forEach((row) => {
                row.forEach((el, i) => delayByEl.set(el, i));
              });
              revealBatchAnimated(inViewChildren, (el) => delayByEl.get(el) ?? 0);
            }

            belowFoldChildren.forEach((el) => el.classList.add('reveal-on-scroll'));

            function scanScrollRows(fast = false) {
              for (const row of allRows) {
                const anchor = row[0];
                if (anchor.classList.contains('is-revealed') || revealScheduled.has(anchor)) {
                  continue;
                }

                const state = getRowRevealState(anchor);
                if (state === 'below') continue;

                if (state === 'passed' || fast) {
                  revealBatchInstant(row);
                  continue;
                }

                revealBatchAnimated(row, (_el, i) => i);
              }
            }

            let lastScrollY = window.scrollY;
            scrollRevealScanners.push(() => {
              const dy = Math.abs(window.scrollY - lastScrollY);
              lastScrollY = window.scrollY;
              const fast = dy > window.innerHeight * 0.35;
              scanScrollRows(fast);
            });

            requestAnimationFrame(() => scanScrollRows(false));
            return;
          }

          if (inViewChildren.length) {
            requestAnimationFrame(() =>
              requestAnimationFrame(() => {
                inViewChildren.forEach((el) => {
                  applyRevealDelay(el, children.indexOf(el));
                });
              }),
            );
          }

          if (!inViewChildren.length && belowFoldChildren.length) {
            children.forEach((el) => el.classList.add('reveal-on-scroll'));
            const groupObserver = new IntersectionObserver(
              (entries) => {
                if (entries.some((e) => e.isIntersecting)) {
                  requestAnimationFrame(() =>
                    requestAnimationFrame(() => revealStaggered(children)),
                  );
                  groupObserver.disconnect();
                }
              },
              SCROLL_OBSERVER,
            );
            groupObserver.observe(group);
          }
        });

        if (scrollRevealScanners.length) {
          let scrollRaf = 0;
          window.addEventListener(
            'scroll',
            () => {
              if (scrollRaf) return;
              scrollRaf = window.requestAnimationFrame(() => {
                scrollRaf = 0;
                scrollRevealScanners.forEach((scan) => scan());
              });
            },
            { passive: true },
          );
        }

        document.documentElement.classList.remove('reveal-pending');
      }

      initRevealAnimations();
    </script>
    <script>
      import { initMediaPlaceholders } from '../lib/media-placeholder';
      initMediaPlaceholders();
    </script>
    {customBodyEnd && <Fragment set:html={customBodyEnd} />}
  </body>
</html>
