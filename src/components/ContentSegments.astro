---
import ContentSegmentRow from './ContentSegmentRow.astro';
import type { ContentSegment } from '../lib/content-segment';
import { isContentSegmentVisible } from '../lib/content-segment';

export type { ContentSegment, ContentSegmentLayout } from '../lib/content-segment';

interface Props {
  segments: ContentSegment[];
  class?: string;
}

const { segments, class: className } = Astro.props;
const visible = segments.filter(isContentSegmentVisible);
---

{visible.length > 0 && (
  <div class:list={['content-segments w-full max-w-content mx-auto px-8', className ?? 'mb-16']} data-reveal>
    {visible.map((segment, i) => (
      <ContentSegmentRow
        segment={segment}
        headingLevel={i === 0 ? 'h1' : 'h2'}
        borderBottom={i < visible.length - 1}
      />
    ))}
  </div>
)}
