---
import ImageSlideshow from './ImageSlideshow.astro';

interface Props {
  items: Array<{
    type: 'image' | 'video';
    src: string;
    alt?: string;
  }>;
}

const { items } = Astro.props;
---

{items.length > 0 && (
<section class="hero-slideshow h-screen flex items-center justify-center relative overflow-hidden bg-site">
  <div class="hero-slideshow__stage w-full max-w-content px-8 flex justify-center items-center h-full relative">
    <ImageSlideshow
      items={items}
      mediaClass="slideshow__media max-w-full max-h-[65vh] w-auto object-contain"
      stageClass="w-full h-full"
    />
  </div>
</section>
)}
