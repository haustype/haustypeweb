---
import ImageSlideshow from './ImageSlideshow.astro';

interface CardImage {
  src: string;
  alt?: string;
}

interface Props {
  name: string;
  category: string;
  styles: number;
  slug: string;
  defaultImage: CardImage;
  hoverImages: CardImage[];
}

const { name, slug, defaultImage, hoverImages, styles } = Astro.props;
const hasHoverSlideshow = hoverImages.length > 1;
---

<article class="rounded-lg overflow-hidden h-full w-full flex flex-col bg-white">
  <a href={`/typefaces/${slug}`} class="flex flex-col h-full min-h-0 group">
    <div
      class="typeface-card__media relative w-full aspect-[4/3] overflow-hidden bg-white flex items-center justify-center"
      data-typeface-card-media
    >
      <img
        src={defaultImage.src}
        alt={defaultImage.alt ?? name}
        width={1600}
        height={1200}
        class="max-w-full max-h-full w-auto h-auto object-contain"
        loading="lazy"
        decoding="async"
      />
      {hasHoverSlideshow && (
        <div
          class="typeface-card__hover-layer absolute inset-0 opacity-0 pointer-events-none bg-white"
          data-typeface-hover-layer
        >
          <ImageSlideshow
            items={hoverImages.map((img) => ({ src: img.src, alt: img.alt ?? name }))}
            objectFit="contain"
            stageClass="h-full w-full"
            hoverOnly
          />
        </div>
      )}
    </div>
    <div class="shrink-0 bg-white px-6 py-4 flex justify-between items-baseline gap-4 transition-opacity group-hover:opacity-80">
      <h3 class="text-base font-normal text-black truncate">
        {name}
      </h3>
      <span class="text-base text-muted shrink-0">
        {styles} {styles === 1 ? 'style' : 'styles'}
      </span>
    </div>
  </a>
</article>

<style>
  .typeface-card__hover-layer.is-active {
    opacity: 1;
    pointer-events: auto;
  }
</style>
