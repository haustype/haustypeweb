---
import PortableText from './PortableText.astro';
import SanityImage from './SanityImage.astro';
import type { ContentSegment } from '../lib/content-segment';

interface Props {
  segment: ContentSegment;
  headingLevel?: 'h1' | 'h2';
  borderBottom?: boolean;
  class?: string;
}

const { segment, headingLevel = 'h2', borderBottom = false, class: className } = Astro.props;
const HeadingTag = headingLevel;
const layout = segment.layout === 'feature' ? 'feature' : 'split';
const hasBodySlot = Astro.slots.has('body');
const hasHeadingExtra = Astro.slots.has('heading-extra');

---

<div
  class:list={[
    'content-segment grid grid-cols-12 gap-4 items-start py-10',
    borderBottom && 'border-b border-site',
    className,
  ]}
>
  {layout === 'split' ? (
    <>
      {(segment.heading?.trim() || hasHeadingExtra) && (
        <div class="content-segment__left col-span-12 md:col-span-3 md:col-start-1 flex flex-col gap-4">
          <header class="content-segment__headline flex flex-col gap-4">
            {segment.heading?.trim() && (
              <HeadingTag class="font-normal text-black m-0">{segment.heading}</HeadingTag>
            )}
            {hasHeadingExtra && <slot name="heading-extra" />}
          </header>
        </div>
      )}

      {(segment.body || hasBodySlot) && (
        <div class="content-segment__body col-span-12 md:col-span-5 md:col-start-4 prose max-w-none">
          {hasBodySlot ? <slot name="body" /> : <PortableText value={segment.body} />}
        </div>
      )}

      {segment.aside && (
        <aside class="content-segment__aside col-span-12 md:col-span-1 md:col-start-10">
          <PortableText value={segment.aside} />
        </aside>
      )}
    </>
  ) : (
    <>
      <div class="content-segment__feature-main col-span-12 md:col-span-8 md:col-start-4 flex flex-col gap-8">
        {segment.heading?.trim() && (
          <header>
            <HeadingTag class="font-normal text-black m-0">{segment.heading}</HeadingTag>
          </header>
        )}
        {hasHeadingExtra && <slot name="heading-extra" />}
        {segment.media?.asset && (
          <SanityImage image={segment.media} width={1200} />
        )}
      </div>

      {(segment.body || hasBodySlot) && (
        <div class="content-segment__feature-body col-span-12 md:col-span-5 md:col-start-4 prose max-w-none">
          {hasBodySlot ? <slot name="body" /> : <PortableText value={segment.body} />}
        </div>
      )}
    </>
  )}
</div>

<style>
  /* Nudge 12px aside down to align first-line baseline with 16px body copy */
  .content-segment__aside {
    font-size: 12px;
    line-height: var(--site-line-height);
    color: rgb(0 0 0 / 0.45);
    padding-top: 4px;
  }

  .content-segment__aside :where(p, li, blockquote) {
    margin: 0;
    line-height: var(--site-line-height);
    color: inherit;
  }

  .content-segment__aside :where(p + p) {
    margin-top: 0.75em;
  }

  .content-segment__aside :where(a) {
    color: var(--site-fg-muted);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .content-segment__aside :where(a:hover) {
    color: var(--site-fg);
  }
</style>
