---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<section class="bg-site pt-20 pb-[104px]">
  <div class="site-grid">
    <h1 class="col-span-12 md:col-span-4 md:col-start-3 text-base text-black font-normal mx-0 mb-0 mt-[4px]" data-reveal>
      {text}
    </h1>
  </div>
</section>
