---
import PortableText from './PortableText.astro';

interface Props {
  styles?: number | null;
  releaseYear?: string | number | null;
  designer?: string | null;
  columnOne?: unknown;
  columnTwo?: unknown;
}

const { styles, releaseYear, designer, columnOne, columnTwo } = Astro.props;

const hasCustomOverride = Boolean(columnOne) || Boolean(columnTwo);

const factRows: Array<{ label: string; value: string }> = [];
if (!hasCustomOverride) {
  if (styles != null && styles > 0) {
    factRows.push({ label: 'Styles', value: String(styles) });
  }
  const year = releaseYear != null ? String(releaseYear).trim() : '';
  if (year) {
    factRows.push({ label: 'Release', value: year });
  }
  if (designer?.trim()) {
    factRows.push({ label: 'Designer', value: designer.trim() });
  }
}

const showFacts = factRows.length > 0;

if (!showFacts && !hasCustomOverride) {
  return null;
}
---

{
  showFacts && (
    <>
      <div class="typeface-hero-meta typeface-hero-meta--labels hidden md:block md:col-span-1 md:col-start-10">
        {factRows.map((row) => (
          <div class="typeface-hero-meta__line">{row.label}:</div>
        ))}
      </div>
      <div class="typeface-hero-meta typeface-hero-meta--values hidden md:block md:col-span-2 md:col-start-11">
        {factRows.map((row) => (
          <div class="typeface-hero-meta__line">{row.value}</div>
        ))}
      </div>
    </>
  )
}

{
  hasCustomOverride && (
    <>
      {columnOne && (
        <div class="typeface-hero-meta hidden md:block md:col-span-1 md:col-start-10">
          <PortableText value={columnOne} />
        </div>
      )}
      {columnTwo && (
        <div class="typeface-hero-meta hidden md:block md:col-span-2 md:col-start-11">
          <PortableText value={columnTwo} />
        </div>
      )}
    </>
  )
}

<style>
  .typeface-hero-meta {
    font-family: var(--site-font);
    font-size: 13px;
    font-weight: 400;
    line-height: var(--site-line-height);
    color: #000;
  }

  .typeface-hero-meta__line {
    margin: 0;
    font-weight: 400;
    color: #000;
  }

  .typeface-hero-meta :global(:where(p, li, blockquote)) {
    margin: 0;
    line-height: var(--site-line-height);
    color: inherit;
    font-weight: 400;
  }

  .typeface-hero-meta :global(:where(p + p)) {
    margin-top: 0.75em;
  }

  .typeface-hero-meta :global(:where(a)) {
    color: #000;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }

  .typeface-hero-meta :global(:where(a:hover)) {
    opacity: 0.72;
  }
</style>
