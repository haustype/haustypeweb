---
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
  class:list={['haus-mark block shrink-0', className]}
  viewBox="0 0 30 30"
  width={size}
  height={size}
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <polygon points="0 10 0 30 30 30 30 10 15 0 0 10" fill="currentColor" />
</svg>
