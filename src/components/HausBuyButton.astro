---
interface Props {
  collectionId: string;
  variant?: 'inline' | 'floating';
}

const { collectionId, variant = 'inline' } = Astro.props;
---

<button
  type="button"
  class:list={[
    'haus-buy-button',
    { 'haus-buy-button--floating': variant === 'floating' },
  ]}
  fontdue-click="open-store-modal"
  fontdue-store-route={`product/${collectionId}`}
>
  Buy →
</button>
