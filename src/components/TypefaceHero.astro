---
import ContentSegmentRow from './ContentSegmentRow.astro';
import TypefaceHeroMeta from './TypefaceHeroMeta.astro';
import type { ContentSegment } from '../lib/content-segment';
import { isContentSegmentVisible } from '../lib/content-segment';
import { hasTypefaceHeroMeta, type TypefaceHeroMetaInput } from '../lib/typeface-hero-meta';

interface HeaderSvg {
  url: string;
  alt?: string;
  width?: number;
  height?: number;
}

interface Props {
  segment?: ContentSegment | null;
  headerSvg?: HeaderSvg | null;
  typefaceName: string;
  bottomPadding?: number;
  heroMeta?: TypefaceHeroMetaInput | null;
}

const { segment, headerSvg, typefaceName, bottomPadding = 36, heroMeta } = Astro.props;

const headerSrc = headerSvg?.url;
const headerAlt = headerSvg?.alt ?? typefaceName;
const showHeroMeta = hasTypefaceHeroMeta(heroMeta);
const showIntro =
  (segment ? isContentSegmentVisible(segment) : false) || showHeroMeta;
const introSegment: ContentSegment | null =
  segment && isContentSegmentVisible(segment)
    ? segment
    : showHeroMeta
      ? { heading: typefaceName, layout: 'split' }
      : null;
---

<section class="typeface-hero site-surface-fixed">
  <div class="typeface-hero__bg" aria-hidden="true"></div>
  <div
    class="typeface-hero__inner w-full max-w-content mx-auto px-8"
    style={`--typeface-hero-padding-bottom: ${bottomPadding}px;`}
  >
    {showIntro && introSegment && (
      <div class="typeface-hero__intro" data-reveal>
        <ContentSegmentRow segment={introSegment} headingLevel="h1" class="site-content-inset">
          {showHeroMeta && heroMeta && (
            <TypefaceHeroMeta
              slot="hero-meta"
              styles={heroMeta.styles}
              releaseYear={heroMeta.releaseYear}
              designer={heroMeta.designer}
              columnOne={heroMeta.columnOne}
              columnTwo={heroMeta.columnTwo}
            />
          )}
        </ContentSegmentRow>
      </div>
    )}

    {headerSrc && (
      <div class="typeface-hero__mark" data-reveal>
        <img
          src={headerSrc}
          alt={headerAlt}
          width={headerSvg?.width}
          height={headerSvg?.height}
          class="typeface-hero__mark-img"
          loading="eager"
          decoding="async"
        />
      </div>
    )}
  </div>
</section>

<style>
  .typeface-hero {
    position: relative;
    height: 100dvh;
    margin-top: calc(-1 * var(--site-header-height));
    padding-top: var(--site-header-height);
    box-sizing: border-box;
    overflow: hidden;
  }

  .typeface-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-color: var(--site-yellow);
    opacity: 0;
    animation: typeface-hero-bg-in 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes typeface-hero-bg-in {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typeface-hero__bg {
      opacity: 1;
      animation: none;
    }
  }

  .typeface-hero__inner {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    padding-bottom: var(--typeface-hero-padding-bottom, 36px);
    box-sizing: border-box;
  }

  .typeface-hero__intro {
    flex: 0 0 auto;
    padding-top: 8rem;
  }

  .typeface-hero__mark {
    flex: 1 1 auto;
    min-height: 0;
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    line-height: 0;
  }

  .typeface-hero__mark-img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    object-position: bottom left;
  }
</style>
