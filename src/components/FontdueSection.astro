---
interface Props {
  /** Align with the right-hand content column (cols 7–12) instead of full width */
  align?: 'content' | 'full';
}

const { align = 'full' } = Astro.props;
---

<div class="fontdue-section w-full max-w-content mx-auto px-8">
  <div class="grid grid-cols-12 gap-4">
    <div
      class:list={[
        'fontdue-section__inner min-w-0',
        align === 'content'
          ? 'col-span-12 md:col-span-6 md:col-start-7'
          : 'col-span-12',
      ]}
    >
      <slot />
    </div>
  </div>
</div>
