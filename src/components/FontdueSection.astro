---
interface Props {
  /** Align with the right-hand content column (cols 4–6) instead of full width */
  align?: 'content' | 'full';
}

const { align = 'full' } = Astro.props;
---

<div class="fontdue-section w-full max-w-content mx-auto px-8">
  <div class="grid grid-cols-6 gap-6">
    <div
      class:list={[
        'fontdue-section__inner min-w-0',
        align === 'content'
          ? 'col-span-6 md:col-span-3 md:col-start-4'
          : 'col-span-6',
      ]}
    >
      <slot />
    </div>
  </div>
</div>
