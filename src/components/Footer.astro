---
import HausMark from './HausMark.astro';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';

const { data: typefacesData } = await safeLoadQuery<
  Array<{ name: string; slug?: { current: string } }>
>({
  query: `*[_type == "typeface"] | order(orderRank){ orderRank, name, slug }`,
});

const { data: siteSettings } = await safeLoadQuery<{
  instagramUrl?: string | null;
  contactEmail?: string | null;
  footerNavigation?: Array<{
    label?: string;
    href?: string;
    external?: boolean;
  }>;
} | null>({
  query: `*[_type == "siteSettings"][0]{
    instagramUrl,
    contactEmail,
    "footerNavigation": footerNavigation[]{
      _type,
      _type == "internalLink" => {
        "label": page->title,
        "href": "/" + page->slug.current,
        "external": false
      },
      _type == "builtInPage" => {
        "href": "/" + route,
        "label": select(
          route == "blog" => "Blog",
          route == "typefaces" => "Typefaces",
          route == "in-use" => "In Use",
          route
        ),
        "external": false
      },
      _type == "externalLink" => {
        "label": label,
        "href": select(
          linkType == "email" => "mailto:" + email,
          url
        ),
        "external": linkType != "email"
      }
    }
  }`,
});

const typefaces = (typefacesData ?? []).map((t) => ({
  name: t.name,
  slug: t.slug?.current ?? t.name.toLowerCase().replace(/\s+/g, '-'),
}));

const mid = Math.ceil(typefaces.length / 2);
const typefacesLeft = typefaces.slice(0, mid);
const typefacesRight = typefaces.slice(mid);

const instagramUrl = siteSettings?.instagramUrl?.trim() || 'https://www.instagram.com/haustype/';
const contactEmail = siteSettings?.contactEmail?.trim() || 'hello@haustype.com';

const footerLinks =
  siteSettings?.footerNavigation
    ?.filter((item) => item.label && item.href)
    .map((item) => ({
      label: item.label!,
      href: item.href!,
      external: item.external ?? false,
    })) ?? [
    { label: 'Instagram', href: instagramUrl, external: true },
    { label: contactEmail, href: `mailto:${contactEmail}`, external: false },
  ];
---

<footer class="site-footer text-white">
  <div class="site-grid site-footer__grid pt-[64px] pb-[128px]">
    <a
      href="/"
      class="site-footer__brand-mark group col-span-6 md:col-span-1 md:col-start-1 md:row-start-1 self-end justify-self-start text-white"
      aria-label="Haus Type home"
    >
      <HausMark class="transition-colors duration-500 ease-out group-hover:text-haus-yellow" />
    </a>

    <a
      href="/"
      class="site-footer__brand-name col-span-6 md:col-span-1 md:col-start-2 md:row-start-1 self-end text-base leading-none text-white hover:opacity-80 transition-opacity"
    >
      Haus Type®
    </a>

    <p class="site-footer__heading col-span-6 md:col-span-1 md:col-start-3 md:row-start-1 self-end m-0">
      Typefaces
    </p>

    <p class="site-footer__heading col-span-6 md:col-span-1 md:col-start-5 md:row-start-1 self-end m-0">
      Contact
    </p>

    <div class="col-span-6 md:col-span-2 md:col-start-3 md:row-start-2 md:self-start mt-4">
      <div class="grid grid-cols-2 gap-x-6">
        <ul class="site-footer__list list-none m-0 p-0 flex flex-col">
          {typefacesLeft.map((typeface) => (
            <li>
              <a
                href={`/typefaces/${typeface.slug}`}
                class="site-footer__link text-base"
              >
                {typeface.name}
              </a>
            </li>
          ))}
        </ul>
        <ul class="site-footer__list list-none m-0 p-0 flex flex-col">
          {typefacesRight.map((typeface) => (
            <li>
              <a
                href={`/typefaces/${typeface.slug}`}
                class="site-footer__link text-base"
              >
                {typeface.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="site-footer__list col-span-6 md:col-span-1 md:col-start-5 md:row-start-2 md:self-start mt-4 list-none m-0 p-0 flex flex-col">
      {footerLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="site-footer__link text-base"
            {...(link.external
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #000000;
  }

  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-rows: auto auto;
    }
  }

  .site-footer__brand-mark {
    display: block;
    width: fit-content;
    line-height: 0;
  }

  .site-footer__brand-name,
  .site-footer__heading {
    transform: translateY(2px);
  }

  .site-footer__heading {
    font-weight: 400;
    line-height: 1;
    color: #ffffff;
  }

  .site-footer__link {
    color: #fff;
    opacity: 0.45;
    transition: opacity 0.25s ease;
  }

  .site-footer__link:hover {
    opacity: 0.8;
  }
</style>
