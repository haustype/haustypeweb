---
import { safeLoadQuery } from '../sanity/lib/safe-fetch';

interface Props {
  variant?: 'dark' | 'light';
  /** Homepage hero: header overlays content with no layout spacer */
  overlay?: boolean;
}

const { variant = 'light', overlay = false } = Astro.props;

const { data: settings } = await safeLoadQuery<{
  navigation?: Array<{ _type?: string; label?: string; href?: string }>;
} | null>({
  query: `*[_type == "siteSettings"][0]{
    "navigation": navigation[]{
      _type,
      _type == "internalLink" => {
        "href": "/" + page->slug.current,
        "label": page->title
      },
      _type == "builtInPage" => {
        "href": "/" + route,
        "label": select(
          route == "blog" => "Blog",
          route == "typefaces" => "Typefaces",
          route == "in-use" => "In Use",
          route
        )
      },
      _type == "externalLink" => {
        "href": url,
        "label": label
      }
    }
  }`,
});

const navItems =
  settings?.navigation?.length
    ? settings.navigation
        .filter((item) => item.label && item.href)
        .map((item) => ({ label: item.label!, href: item.href! }))
    : [
        { href: '/typefaces', label: 'Typefaces' },
        { href: '/in-use', label: 'In Use' },
        { href: '/projects', label: 'Projects' },
        { href: '/information', label: 'Information' },
      ];

const isDark = variant === 'dark';
---

<header
  class:list={[
    'site-header fixed top-0 left-0 right-0 z-50 bg-transparent',
    isDark ? 'text-white' : 'text-black',
  ]}
  data-site-header
>
  <div class="site-grid relative z-[51] pt-6 pb-6 items-end" data-reveal data-reveal-once="true">
    <a
      href="/"
      class="site-header__brand contents"
      aria-label="Haus Type home"
    >
      <svg
        class="site-header__logo col-start-1 self-end h-[30px] w-[30px] justify-self-start shrink-0"
        viewBox="0 0 30 30"
        width="30"
        height="30"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <polygon points="0 10 0 30 30 30 30 10 15 0 0 10" fill="currentColor" />
      </svg>
      <span class="site-header__name col-start-2 self-end justify-self-start min-w-0 font-normal text-base leading-none" data-site-header-name>Haus Type®</span>
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="site-header__menu-toggle xl:hidden col-start-6 self-end justify-self-end mr-14 xl:mr-0 p-2 -m-2 rounded-none hover:opacity-80 transition-opacity bg-transparent border-none cursor-pointer text-inherit shrink-0"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="nav-icon-open w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="butt" stroke-linejoin="miter" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="nav-icon-close w-6 h-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="butt" stroke-linejoin="miter" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <nav
      class="site-header__nav hidden xl:flex col-span-3 col-start-4 self-end items-end justify-start gap-[36px] flex-nowrap min-w-0 pr-16"
      aria-label="Main navigation"
    >
      {navItems.map((item) => (
        <a href={item.href} class="text-base leading-none hover:opacity-80 transition-opacity whitespace-nowrap">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
  <button
    type="button"
    fontdue-click="open-store-modal"
    fontdue-store-route="cart"
    class:list={[
      'site-header__cart fixed top-6 right-8 z-[52] h-[30px] flex items-end text-base leading-none hover:opacity-80 transition-opacity bg-transparent border-none cursor-pointer font-inherit whitespace-nowrap p-0',
      isDark ? 'text-white' : 'text-black',
    ]}
  >
    <span class="translate-y-[2px]">Cart</span>
  </button>
  <div
    id="nav-menu"
    class="xl:hidden hidden fixed inset-0 z-50 flex flex-col items-center justify-center px-8 pt-16 pb-16"
    class:list={[isDark ? 'bg-black text-white' : 'bg-site text-black']}
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-[1.5rem] items-center" aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a href={item.href} class="text-[1.5rem] leading-normal py-2 hover:opacity-80 transition-opacity">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
{!overlay && <div class="site-header-spacer h-[5.5rem]" aria-hidden="true" />}

<style>
  .site-header {
    background-color: transparent;
  }

  .site-header__logo,
  .site-header__name,
  .site-header__nav,
  .site-header__menu-toggle {
    transition: opacity 0.25s ease;
  }

  .site-header__brand:hover .site-header__logo,
  .site-header__brand:hover .site-header__name {
    opacity: 0.8;
  }

  /* Single-line UI: tight line-height so items-end aligns with 30px logo; 2px optical nudge */
  .site-header__name,
  .site-header__nav a,
  .site-header__cart {
    line-height: 1;
  }

  .site-header__name,
  .site-header__nav {
    transform: translateY(2px);
  }

  .site-header__name {
    overflow: hidden;
    white-space: nowrap;
    opacity: 1;
    max-width: 11rem;
    transition: opacity 0.25s ease, max-width 0s ease 0s;
  }

  .site-header.is-compact .site-header__name,
  .site-header.is-compact .site-header__nav,
  .site-header.is-compact .site-header__menu-toggle {
    opacity: 0;
    pointer-events: none;
  }

  .site-header.is-compact .site-header__name {
    max-width: 0;
    transition: opacity 0.25s ease, max-width 0s ease 0.25s;
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const iconOpen = document.querySelector('.nav-icon-open');
  const iconClose = document.querySelector('.nav-icon-close');
  const header = document.querySelector('[data-site-header]');
  const scrollThreshold = 24;
  let lastScrollY = window.scrollY;
  let compact = window.scrollY > scrollThreshold;

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden');
    toggle?.setAttribute('aria-expanded', String(!isOpen));
    toggle?.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    menu?.setAttribute('aria-hidden', String(isOpen));
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  function updateHeaderScroll() {
    if (!header) return;

    const scrollY = window.scrollY;

    if (scrollY <= scrollThreshold) {
      compact = false;
    } else if (scrollY > lastScrollY) {
      compact = true;
    } else if (scrollY < lastScrollY) {
      compact = false;
    }

    const atTop = scrollY <= scrollThreshold;

    header.classList.toggle('is-compact', compact && !atTop);

    if (compact && menu && !menu.classList.contains('hidden')) {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-label', 'Toggle menu');
      menu.setAttribute('aria-hidden', 'true');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    lastScrollY = scrollY;
  }

  updateHeaderScroll();
  window.addEventListener('scroll', updateHeaderScroll, { passive: true });
</script>
