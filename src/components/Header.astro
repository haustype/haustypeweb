---
import HausMark from './HausMark.astro';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';

const { data: settings } = await safeLoadQuery<{
  navigation?: Array<{ _type?: string; label?: string; href?: string }>;
} | null>({
  query: `*[_type == "siteSettings"][0]{
    "navigation": navigation[]{
      _type,
      _type == "internalLink" => {
        "href": "/" + page->slug.current,
        "label": page->title
      },
      _type == "builtInPage" => {
        "href": "/" + route,
        "label": select(
          route == "blog" => "Blog",
          route == "typefaces" => "Typefaces",
          route == "in-use" => "In Use",
          route
        )
      },
      _type == "externalLink" => {
        "href": url,
        "label": label
      }
    }
  }`,
});

const navItems =
  settings?.navigation?.length
    ? settings.navigation
        .filter((item) => item.label && item.href)
        .map((item) => ({ label: item.label!, href: item.href! }))
    : [
        { href: '/typefaces', label: 'Typefaces' },
        { href: '/in-use', label: 'In Use' },
        { href: '/projects', label: 'Projects' },
        { href: '/information', label: 'Information' },
      ];
---

<header class="site-header sticky top-0 z-50 p-4" data-site-header>
  <div class="site-header__shell h-[64px] w-full overflow-hidden rounded-[10px] bg-white px-4 text-black">
    <div class="site-header__bar grid h-full w-full grid-cols-6 items-center gap-6">
      <a
        href="/"
        class="site-header__logo-link group col-start-1 flex items-center justify-self-start"
        aria-label="Haus Type home"
      >
        <HausMark class="site-header__mark -translate-y-px transition-colors duration-500 ease-out group-hover:text-haus-yellow" />
      </a>

      <a
        href="/"
        class="site-header__name col-start-2 flex min-w-0 items-center justify-self-start text-base leading-none hover:opacity-80 transition-opacity"
      >
        Haus Type®
      </a>

      <nav
        class="site-header__nav col-span-2 col-start-4 flex min-w-0 items-center gap-7"
        aria-label="Main navigation"
      >
        {navItems.map((item) => (
          <a href={item.href} class="text-base leading-none hover:opacity-80 transition-opacity whitespace-nowrap">
            {item.label}
          </a>
        ))}
      </nav>

      <div class="site-header__actions col-start-6 flex items-center justify-self-end gap-6">
        <button
          type="button"
          id="nav-toggle"
          class="site-header__menu-toggle site-header__action-btn text-base leading-none rounded-none hover:opacity-80 transition-opacity bg-transparent border-none cursor-pointer text-inherit shrink-0"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span class="site-header__menu-toggle-inner" aria-hidden="true">
            <svg class="nav-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 12" stroke="currentColor">
              <path stroke-linecap="butt" stroke-linejoin="miter" stroke-width="1.5" d="M0 1h16M0 6h16M0 11h16" />
            </svg>
            <svg class="nav-icon-close hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16" stroke="currentColor">
              <path stroke-linecap="butt" stroke-linejoin="miter" stroke-width="1.5" d="M1 1 15 15M15 1 1 15" />
            </svg>
          </span>
        </button>

        <button
          type="button"
          fontdue-click="open-store-modal"
          fontdue-store-route="cart"
          class="site-header__cart site-header__action-btn text-base leading-none hover:opacity-80 transition-opacity bg-transparent border-none cursor-pointer font-inherit whitespace-nowrap"
        >
          Cart
        </button>
      </div>
    </div>
  </div>

  <div
    id="nav-menu"
    class="site-header__menu-panel hidden fixed inset-0 z-[60] flex flex-col items-center justify-center bg-site px-8 pt-16 pb-16 text-black"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-[1.5rem] items-center" aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a href={item.href} class="text-[1.5rem] leading-normal py-2 hover:opacity-80 transition-opacity">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .site-header__shell {
    container-type: inline-size;
    container-name: site-header;
  }

  .site-header__name {
    overflow: hidden;
    white-space: nowrap;
    max-width: 11rem;
    transition: opacity 0.25s ease, max-width 0s ease 0s;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 100%;
    margin: 0;
  }

  .site-header__menu-toggle {
    display: flex;
    padding: 0 8px;
    min-width: 44px;
  }

  .site-header__cart {
    padding: 0;
    min-width: 0;
  }

  .site-header__menu-toggle-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1em;
    height: 1em;
    line-height: 0;
  }

  .site-header__menu-toggle-inner svg.hidden {
    display: none;
  }

  .site-header__menu-toggle-inner .nav-icon-open:not(.hidden) {
    display: block;
    width: 1em;
    height: 0.75em;
  }

  .site-header__menu-toggle-inner .nav-icon-close:not(.hidden) {
    display: block;
    width: 0.9375em;
    height: 0.9375em;
  }

  @media (min-width: 1024px) {
    @container site-header (min-width: 44rem) {
      .site-header__nav {
        display: flex;
      }

      .site-header__menu-toggle {
        display: none;
      }
    }

    @container site-header (min-width: 44rem) and (max-width: 54rem) {
      .site-header__name {
        opacity: 0;
        max-width: 0;
        pointer-events: none;
      }
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const iconOpen = document.querySelector('.nav-icon-open');
  const iconClose = document.querySelector('.nav-icon-close');
  const header = document.querySelector('[data-site-header]');
  const scrollThreshold = 24;
  let lastScrollY = window.scrollY;

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden');
    toggle?.setAttribute('aria-expanded', String(!isOpen));
    toggle?.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    menu?.setAttribute('aria-hidden', String(isOpen));
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    document.body.style.overflow = isOpen ? '' : 'hidden';
  });

  function closeMenu() {
    if (!menu || menu.classList.contains('hidden')) return;
    menu.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Toggle menu');
    menu.setAttribute('aria-hidden', 'true');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  function updateHeaderScroll() {
    if (!header) return;

    const scrollY = window.scrollY;

    if (scrollY <= scrollThreshold) {
      header.classList.remove('is-hidden');
    } else if (scrollY > lastScrollY) {
      header.classList.add('is-hidden');
      closeMenu();
    } else if (scrollY < lastScrollY) {
      header.classList.remove('is-hidden');
    }

    lastScrollY = scrollY;
  }

  updateHeaderScroll();
  window.addEventListener('scroll', updateHeaderScroll, { passive: true });
</script>
