---
import HausMark from './HausMark.astro';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';

const { data: settings } = await safeLoadQuery<{
  navigation?: Array<{ _type?: string; label?: string; href?: string }>;
} | null>({
  query: `*[_type == "siteSettings"][0]{
    "navigation": navigation[]{
      _type,
      _type == "internalLink" => {
        "href": "/" + page->slug.current,
        "label": page->title
      },
      _type == "builtInPage" => {
        "href": "/" + route,
        "label": select(
          route == "blog" => "Blog",
          route == "typefaces" => "Typefaces",
          route == "in-use" => "In Use",
          route
        )
      },
      _type == "externalLink" => {
        "href": url,
        "label": label
      }
    }
  }`,
});

const navItems =
  settings?.navigation?.length
    ? settings.navigation
        .filter((item) => item.label && item.href)
        .map((item) => ({ label: item.label!, href: item.href! }))
    : [
        { href: '/typefaces', label: 'Typefaces' },
        { href: '/in-use', label: 'In Use' },
        { href: '/projects', label: 'Projects' },
        { href: '/information', label: 'Information' },
      ];
---

<header class="site-header sticky top-0 z-50 p-4" data-site-header>
  <div class="site-header__shell h-[60px] w-full overflow-hidden rounded-[10px] bg-white px-4 text-black">
    <div class="site-header__bar grid h-full w-full grid-cols-12 items-center gap-4">
      <div class="site-header__brand col-start-1 col-span-10 lg:col-span-3 flex min-w-0 items-center gap-8">
        <a
          href="/"
          class="site-header__logo-link flex shrink-0 items-center justify-self-start text-black hover:text-haus-yellow"
          aria-label="Haus Type home"
        >
          <HausMark class="site-header__mark text-inherit" />
        </a>

        <a
          href="/"
          class="site-header__name flex min-w-0 items-center text-base leading-none"
        >
          Haus Type®
        </a>
      </div>

      <nav
        class="site-header__nav col-span-6 col-start-4 flex min-w-0 items-center gap-8"
        aria-label="Main navigation"
      >
        {navItems.map((item) => (
          <a href={item.href} class="text-base leading-none whitespace-nowrap">
            {item.label}
          </a>
        ))}
      </nav>

      <div class="site-header__actions col-start-11 col-span-2 flex items-center justify-self-end gap-6">
        <button
          type="button"
          id="nav-toggle"
          class="site-header__menu-toggle site-header__action-btn text-base leading-none rounded-none bg-transparent border-none cursor-pointer text-inherit shrink-0"
          aria-label="Toggle menu"
          aria-expanded="false"
        >
          <span class="site-header__menu-toggle-inner" aria-hidden="true">
            <svg class="nav-icon-open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 12" aria-hidden="true">
              <path
                stroke="#000000"
                stroke-linecap="butt"
                stroke-linejoin="miter"
                stroke-width="1"
                vector-effect="non-scaling-stroke"
                d="M0 1h16M0 6h16M0 11h16"
              />
            </svg>
          </span>
        </button>

        <button
          type="button"
          fontdue-click="open-store-modal"
          fontdue-store-route="cart"
          class="site-header__cart site-header__action-btn text-base leading-none bg-transparent border-none cursor-pointer font-inherit whitespace-nowrap"
        >
          Cart
        </button>
      </div>
    </div>
  </div>

  <div
    id="nav-menu"
    class="site-header__menu-panel hidden fixed inset-0 flex flex-col items-center justify-center px-8 pt-16 pb-16 text-black"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-[1.5rem] items-center" aria-label="Mobile navigation">
      {navItems.map((item) => (
        <a href={item.href} class="text-[1.5rem] leading-normal py-2 hover:opacity-80 transition-opacity">
          {item.label}
        </a>
      ))}
      <button
        type="button"
        data-mobile-cart
        fontdue-click="open-store-modal"
        fontdue-store-route="cart"
        class="text-[1.5rem] leading-normal py-2 hover:opacity-80 transition-opacity bg-transparent border-none cursor-pointer font-inherit text-inherit"
      >
        Cart
      </button>
    </nav>
  </div>

  <button
    type="button"
    id="nav-close"
    class="site-header__menu-close hidden"
    aria-label="Close menu"
  >
    <svg class="nav-icon-close-overlay" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16" aria-hidden="true">
      <path
        stroke="#000000"
        stroke-linecap="butt"
        stroke-linejoin="miter"
        stroke-width="1"
        vector-effect="non-scaling-stroke"
        d="M1 1 15 15M15 1 1 15"
      />
    </svg>
  </button>
</header>

<style>
  .site-header {
    transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .site-header__shell {
    position: relative;
    z-index: 2;
    container-type: inline-size;
    container-name: site-header;
  }

  .site-header__menu-panel {
    z-index: 1;
  }

  .site-header.is-menu-open .site-header__menu-toggle {
    visibility: hidden;
  }

  .site-header__menu-close {
    position: fixed;
    top: calc(1rem + 30px);
    right: calc(1rem + 1rem);
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    color: #000000;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .site-header__menu-close.hidden {
    display: none;
  }

  .nav-icon-close-overlay {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .site-header__name {
    overflow: hidden;
    white-space: nowrap;
    flex-shrink: 0;
    max-width: 11rem;
    transition: opacity 0.25s ease, max-width 0s ease 0s;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 100%;
    margin: 0;
  }

  .site-header__menu-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 44px;
    height: 44px;
    padding: 0;
    flex-shrink: 0;
  }

  .site-header__cart {
    display: none;
    padding: 0;
    min-width: 0;
  }

  .site-header__menu-toggle-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    line-height: 0;
  }

  .site-header__menu-toggle-inner .nav-icon-open {
    display: block;
    width: 1.5rem;
    height: 1.125rem;
  }

  @media (min-width: 1024px) {
    @container site-header (min-width: 44rem) {
      .site-header__nav {
        display: flex;
      }

      .site-header__menu-toggle {
        display: none;
      }

      .site-header__cart {
        display: flex;
      }
    }

    @container site-header (min-width: 44rem) and (max-width: 54rem) {
      .site-header__name {
        opacity: 0;
        max-width: 0;
        pointer-events: none;
      }
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menuClose = document.getElementById('nav-close');
  const menu = document.getElementById('nav-menu');
  const header = document.querySelector('[data-site-header]');
  const scrollThreshold = 32;
  let lastScrollY = window.scrollY;

  function setMenuOpen(open: boolean) {
    if (!menu || !toggle) return;
    menu.classList.toggle('hidden', !open);
    header?.classList.toggle('is-menu-open', open);
    menuClose?.classList.toggle('hidden', !open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.setAttribute('aria-hidden', String(!open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') ?? true;
    setMenuOpen(isOpen);
  });

  menuClose?.addEventListener('click', () => {
    closeMenu();
  });

  document.querySelector('[data-mobile-cart]')?.addEventListener('click', () => {
    closeMenu();
  });

  function closeMenu() {
    if (!menu || menu.classList.contains('hidden')) return;
    setMenuOpen(false);
  }

  function updateHeaderScroll() {
    if (!header) return;

    const scrollY = window.scrollY;

    if (scrollY <= scrollThreshold) {
      header.classList.remove('is-hidden');
    } else if (scrollY > lastScrollY) {
      header.classList.add('is-hidden');
      closeMenu();
    } else if (scrollY < lastScrollY) {
      header.classList.remove('is-hidden');
    }

    lastScrollY = scrollY;
  }

  updateHeaderScroll();
  window.addEventListener('scroll', updateHeaderScroll, { passive: true });
</script>
