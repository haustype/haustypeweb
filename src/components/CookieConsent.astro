---
interface Props {
  gaId?: string | null;
  privacyHref?: string;
}

const { gaId = null, privacyHref = '/privacy' } = Astro.props;
const measurementId = gaId?.trim() || '';
---

{
  measurementId && (
    <div
      class="cookie-consent"
      data-cookie-consent
      data-ga-id={measurementId}
      data-privacy-href={privacyHref}
      hidden
      role="dialog"
      aria-live="polite"
      aria-label="Cookie consent"
    >
      <p class="cookie-consent__text">
        We use cookies for Google Analytics to understand how the site is used.
        <a href={privacyHref} class="cookie-consent__link">Privacy policy</a>
      </p>
      <div class="cookie-consent__actions">
        <button type="button" class="cookie-consent__btn cookie-consent__btn--ghost" data-cookie-reject>
          Reject
        </button>
        <button type="button" class="cookie-consent__btn cookie-consent__btn--solid" data-cookie-accept>
          Accept
        </button>
      </div>
    </div>
  )
}

<script is:inline define:vars={{ measurementId }}>
  (function () {
    if (!measurementId) return;

    var KEY = 'cookie-consent';
    var banner = document.querySelector('[data-cookie-consent]');

    function readConsent() {
      try {
        return localStorage.getItem(KEY);
      } catch (_) {
        return null;
      }
    }

    function writeConsent(value) {
      try {
        localStorage.setItem(KEY, value);
      } catch (_) {}
    }

    function loadAnalytics() {
      if (window.__hausGaLoaded) return;
      window.__hausGaLoaded = true;
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', measurementId);
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(measurementId);
      document.head.appendChild(s);
    }

    function hideBanner(animate) {
      if (!banner) return;
      banner.classList.remove('is-visible');
      banner.setAttribute('aria-hidden', 'true');
      if (!animate) {
        banner.hidden = true;
        return;
      }
      var finished = false;
      function done() {
        if (finished) return;
        finished = true;
        banner.hidden = true;
        banner.removeEventListener('transitionend', onEnd);
      }
      function onEnd(event) {
        if (event.propertyName === 'opacity') done();
      }
      banner.addEventListener('transitionend', onEnd);
      window.setTimeout(done, 500);
    }

    function showBanner() {
      if (!banner) return;
      banner.hidden = false;
      banner.setAttribute('aria-hidden', 'false');
      // Match site reveal: short beat after paint, then fade in.
      var reduceMotion =
        window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var delay = reduceMotion ? 0 : 450;
      window.setTimeout(function () {
        if (banner.hidden) return;
        requestAnimationFrame(function () {
          banner.classList.add('is-visible');
        });
      }, delay);
    }

    var consent = readConsent();
    if (consent === 'accepted') {
      loadAnalytics();
      hideBanner(false);
      return;
    }
    if (consent === 'rejected') {
      hideBanner(false);
      return;
    }

    showBanner();

    if (!banner) return;
    var acceptBtn = banner.querySelector('[data-cookie-accept]');
    var rejectBtn = banner.querySelector('[data-cookie-reject]');
    if (acceptBtn) {
      acceptBtn.addEventListener('click', function () {
        writeConsent('accepted');
        loadAnalytics();
        hideBanner(true);
      });
    }
    if (rejectBtn) {
      rejectBtn.addEventListener('click', function () {
        writeConsent('rejected');
        hideBanner(true);
      });
    }
  })();
</script>

<style>
  .cookie-consent {
    position: fixed;
    left: var(--site-edge-padding);
    bottom: var(--site-edge-padding);
    z-index: 45;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    max-width: min(36rem, calc(100vw - 2 * var(--site-edge-padding) - 8rem));
    min-height: 40px;
    padding: 0.65rem 0.85rem;
    border-radius: 10px;
    background: #000000;
    color: #ffffff;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cookie-consent.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .cookie-consent[hidden] {
    display: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-consent {
      transition: none;
    }
  }

  .cookie-consent__text {
    margin: 0;
    flex: 1 1 12rem;
    font-size: 0.875rem;
    line-height: var(--site-line-height);
    color: #ffffff;
  }

  .cookie-consent__link {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .cookie-consent__link:hover {
    opacity: 0.8;
  }

  .cookie-consent__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cookie-consent__btn {
    height: 32px;
    padding: 0 0.85rem;
    border-radius: 10px;
    border: none;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
  }

  .cookie-consent__btn--ghost {
    background: transparent;
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
  }

  .cookie-consent__btn--ghost:hover {
    background: rgb(255 255 255 / 0.08);
  }

  .cookie-consent__btn--solid {
    background: #ffffff;
    color: #000000;
  }

  .cookie-consent__btn--solid:hover {
    opacity: 0.9;
  }

  @media (max-width: 767px) {
    .cookie-consent {
      right: var(--site-edge-padding);
      max-width: none;
      /* Keep clear of the bg toggle on the right */
      padding-right: 3.5rem;
    }

    .cookie-consent__actions {
      margin-left: auto;
    }
  }
</style>
