---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ContentSegmentRow from '../../components/ContentSegmentRow.astro';
import { safeLoadQuery } from '../../sanity/lib/safe-fetch';

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!slug) {
  return Astro.redirect('/404');
}

const { data: post } = await safeLoadQuery<{
  title: string;
  description?: string;
  publishedAt?: string;
  author?: string;
  mainImage?: unknown;
  body?: unknown;
  aside?: unknown;
} | null>({
  query: `*[_type == "post" && slug.current == $slug && !draft][0]{
    title,
    description,
    publishedAt,
    author,
    mainImage,
    body,
    aside
  }`,
  params: { slug },
});

if (!post) {
  return Astro.redirect('/404');
}

const title = post.title;
const description = post.description ?? '';
const pubDate = post.publishedAt ? new Date(post.publishedAt) : new Date();
const author = post.author ?? '';
const body = post.body;
const aside = post.aside;
const image = post.mainImage
  ? (await import('../../sanity/lib/url-for-image')).urlForImage(post.mainImage).url()
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
>
  <Header />
  <main class="bg-site flex-1">
    <article class="site-page">
      <div class="content-segments w-full max-w-content mx-auto px-8 site-content-trail" data-reveal>
        <ContentSegmentRow
          segment={{
            heading: title,
            body,
            aside: aside || undefined,
          }}
          headingLevel="h1"
        >
          {author || pubDate ? (
            <div slot="heading-extra" class="flex flex-col gap-1">
              {author && <span class="text-sm text-muted">By {author}</span>}
              <time datetime={pubDate.toISOString()} class="text-muted text-sm">
                {pubDate.toLocaleDateString('en-GB', { dateStyle: 'long' })}
              </time>
            </div>
          ) : null}
        </ContentSegmentRow>
      </div>
    </article>
  </main>
</BaseLayout>
