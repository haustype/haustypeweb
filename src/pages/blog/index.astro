---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ContentSegmentRow from '../../components/ContentSegmentRow.astro';
import { safeLoadQuery } from '../../sanity/lib/safe-fetch';

const { data: siteSettings } = await safeLoadQuery<{ blogPageTitle?: string | null } | null>({
  query: `*[_type == "siteSettings"][0]{ blogPageTitle }`,
});

const blogTitle = siteSettings?.blogPageTitle?.trim() ?? '';

const { data: sanityPosts } = await safeLoadQuery<Array<{
  title: string;
  slug?: { current: string };
  publishedAt?: string;
  description?: string;
}>>({
  query: `*[_type == "post" && !draft] | order(publishedAt desc){ title, slug, publishedAt, description }`,
});

const posts = (sanityPosts ?? []).map((p) => ({
  slug: p.slug?.current ?? p.title.toLowerCase().replace(/\s+/g, '-'),
  data: {
    title: p.title,
    description: p.description,
    pubDate: p.publishedAt ? new Date(p.publishedAt) : new Date(),
  },
}));
---

<BaseLayout title={blogTitle}>
  <Header />
  <main class="bg-site flex-1">
    <article class="site-page">
      <div class="content-segments w-full max-w-content mx-auto px-8 site-content-trail" data-reveal>
        <ContentSegmentRow segment={blogTitle ? { heading: blogTitle } : {}} headingLevel="h1">
          <div slot="body" class="not-prose flex flex-col gap-8">
            {posts.map((post) => (
              <article>
                <a href={`/blog/${post.slug}`} class="block group">
                  <h2 class="text-xl font-normal text-black group-hover:opacity-80 transition-opacity">
                    {post.data.title}
                  </h2>
                  <time datetime={post.data.pubDate.toISOString()} class="text-muted text-sm block mt-1">
                    {post.data.pubDate.toLocaleDateString('en-GB', { dateStyle: 'medium' })}
                  </time>
                </a>
              </article>
            ))}
          </div>
        </ContentSegmentRow>
      </div>
    </article>
  </main>
</BaseLayout>
