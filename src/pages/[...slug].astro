---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContentSegments from '../components/ContentSegments.astro';
import FontdueSection from '../components/FontdueSection.astro';
import HausBuyButton from '../components/HausBuyButton.astro';
import PortableText from '../components/PortableText.astro';
import { getCollection } from 'astro:content';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';

export async function getStaticPaths() {
  const { data: sanityPages } = await safeLoadQuery<Array<{ slug?: { current: string } }>>({
    query: `*[_type == "page"]{ slug }`,
  });

  if (sanityPages?.length) {
    const paths = sanityPages
      .map((p) => p.slug?.current)
      .filter((slug): slug is string => Boolean(slug))
      .map((slug) => ({
        params: { slug },
        props: { source: 'sanity' as const },
      }));

    if (paths.length) {
      return paths;
    }
  }

  const pages = await getCollection('pages');
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page, source: 'astro' as const },
  }));
}

const { slug } = Astro.params;
const { source, page: astroPage } = Astro.props;

let title = '';
let description = '';

type ContentSegment = {
  heading?: string;
  body?: unknown;
};

type PageSection = {
  _key?: string;
  sectionType: 'typeTester' | 'characterViewer' | 'buyButton' | 'content';
  typeface?: { slug?: { current: string }; name?: string; collectionId?: string };
  content?: unknown;
};

let contentSegments: ContentSegment[] = [];
let pageSections: PageSection[] = [];

if (source === 'sanity') {
  const { data: page } = await safeLoadQuery<{
    title: string;
    description?: string;
    body?: unknown;
    contentSegments?: ContentSegment[] | null;
    pageSections?: PageSection[] | null;
  }>({
    query: `*[_type == "page" && slug.current == $slug][0]{
      title,
      description,
      body,
      contentSegments[]{ heading, body },
      pageSections[]{
        _key,
        sectionType,
        content,
        typeface->{ slug, name, collectionId }
      }
    }`,
    params: { slug },
  });
  if (page) {
    title = page.title;
    description = page.description ?? '';
    contentSegments =
      page.contentSegments?.length
        ? page.contentSegments
        : page.body
          ? [{ heading: page.title, body: page.body }]
          : [];
    pageSections = page.pageSections ?? [];
  }
} else if (astroPage) {
  title = astroPage.data.title;
  description = astroPage.data.description ?? '';
}

const astroContent = astroPage ? await astroPage.render() : null;
---

<BaseLayout
  title={`${title} | Haus Type`}
  description={description}
>
  <Header />
  <main class="bg-site flex-1" data-reveal>
    <article class="w-full pt-24 pb-20">
      {source === 'sanity' ? (
        <ContentSegments segments={contentSegments} />
      ) : astroContent ? (
        <div class="site-grid heading-row mb-16 w-full max-w-content mx-auto px-8">
          <header class="site-grid__left">
            <h1 class="font-normal text-black">{title}</h1>
          </header>
          <div class="site-grid__right prose max-w-none">
            <astroContent.Content />
          </div>
        </div>
      ) : null}
      {source === 'sanity' && pageSections.length > 0 && (
        <div class="w-full flex flex-col gap-16">
          {pageSections.map((section) => {
            const collectionSlug = section.typeface?.slug?.current;
            const typefaceName = section.typeface?.name;
            const collectionId = section.typeface?.collectionId;
            if (section.sectionType === 'typeTester' && collectionSlug) {
              return (
                <FontdueSection>
                  <fontdue-type-testers collection-slug={collectionSlug} />
                </FontdueSection>
              );
            }
            if (section.sectionType === 'characterViewer' && collectionSlug) {
              return (
                <FontdueSection>
                  <fontdue-character-viewer collection-slug={collectionSlug} />
                </FontdueSection>
              );
            }
            if (section.sectionType === 'buyButton' && collectionId && typefaceName) {
              return (
                <FontdueSection align="content">
                  <HausBuyButton collectionId={collectionId} />
                </FontdueSection>
              );
            }
            if (section.sectionType === 'content' && section.content) {
              return (
                <FontdueSection align="content">
                  <div class="prose max-w-none">
                    <PortableText value={section.content} />
                  </div>
                </FontdueSection>
              );
            }
            return null;
          })}
        </div>
      )}
    </article>
  </main>
</BaseLayout>
