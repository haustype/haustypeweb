---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContentSegments, { type ContentSegment } from '../components/ContentSegments.astro';
import { sanityImageProjection } from '../lib/sanity-image';
import FontdueSection from '../components/FontdueSection.astro';
import HausBuyButton from '../components/HausBuyButton.astro';
import PortableText from '../components/PortableText.astro';
import PageCustomEmbed from '../components/PageCustomEmbed.astro';
import FontsInUseMosaic from '../components/FontsInUseMosaic.astro';
import { galleryItemProjection, mapGalleryItems } from '../lib/gallery-items';
import { resolvePageLayout } from '../lib/gallery-pages';
import type { SanityImageValue } from '../lib/sanity-image';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';
import { urlForImage } from '../sanity/lib/url-for-image';

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

if (!slug) {
  return Astro.redirect('/404');
}

let title = '';
let description = '';

const contentSegmentProjection = `{
  layout,
  hideOnMobile,
  heading,
  media ${sanityImageProjection},
  body,
  aside
}`;

type PageSection = {
  _key?: string;
  sectionType: 'typeTester' | 'characterViewer' | 'buyButton' | 'content';
  typeface?: { slug?: { current: string }; name?: string; collectionId?: string };
  content?: unknown;
};

let contentSegments: ContentSegment[] = [];
let pageSections: PageSection[] = [];
let customEmbed = '';
let pageLayout: 'standard' | 'gallery' = 'standard';
let mosaicItems = mapGalleryItems([]);
let ordersIllustrationUrl: string | null = null;

const { data: page } = await safeLoadQuery<{
  title: string;
  description?: string;
  body?: unknown;
  pageLayout?: 'standard' | 'gallery' | null;
  contentSegments?: ContentSegment[] | null;
  pageSections?: PageSection[] | null;
  customEmbed?: string | null;
  inUseGallery?: unknown[] | null;
  ordersIllustration?: SanityImageValue | null;
} | null>({
  query: `*[_type == "page" && slug.current == $slug][0]{
    title,
    description,
    body,
    pageLayout,
    customEmbed,
    ordersIllustration ${sanityImageProjection},
    contentSegments[]${contentSegmentProjection},
    pageSections[]{
      _key,
      sectionType,
      content,
      typeface->{ slug, name, collectionId }
    },
    inUseGallery[]${galleryItemProjection}
  }`,
  params: { slug },
});

if (page) {
  title = page.title;
  description = page.description ?? '';
  pageLayout = resolvePageLayout(page.pageLayout, slug);
  contentSegments =
    page.contentSegments?.length
      ? page.contentSegments
      : page.body
        ? [{ heading: page.title, body: page.body }]
        : [];
  pageSections = page.pageSections ?? [];
  customEmbed = page.customEmbed?.trim() ?? '';
  mosaicItems = mapGalleryItems(page.inUseGallery ?? []);
  if (page.ordersIllustration?.asset) {
    ordersIllustrationUrl = urlForImage(page.ordersIllustration)
      .height(680)
      .format('png')
      .url();
  }
} else {
  return Astro.redirect('/404');
}
const isGalleryPage = pageLayout === 'gallery';
const isOrdersPage = slug === 'orders';
const ordersIllustrationSrc = isOrdersPage
  ? (ordersIllustrationUrl ?? '/images/hauser.png')
  : null;
---

<BaseLayout
  title={title}
  description={description}
>
  <Header />
  <main class="bg-site flex-1">
    <article
      class:list={[
        'site-page-top',
        isGalleryPage || (customEmbed && !isOrdersPage)
          ? 'site-page--gallery'
          : isOrdersPage
            ? 'site-page--orders'
            : 'site-page--default',
        isGalleryPage && 'gallery-page',
        customEmbed && 'page-with-custom-embed',
        isOrdersPage && 'orders-page__article',
      ]}
    >
      <ContentSegments
        segments={contentSegments}
        class={isGalleryPage || customEmbed ? 'mb-0' : undefined}
      />
      {isGalleryPage && (
        <div class="gallery-page__mosaic">
          <FontsInUseMosaic items={mosaicItems} />
        </div>
      )}
      {!isGalleryPage && pageSections.length > 0 && (
        <div class="w-full flex flex-col gap-16">
          {pageSections.map((section) => {
            const collectionSlug = section.typeface?.slug?.current;
            const typefaceName = section.typeface?.name;
            const collectionId = section.typeface?.collectionId;
            if (section.sectionType === 'typeTester' && collectionSlug) {
              return (
                <FontdueSection>
                  <fontdue-type-testers collection-slug={collectionSlug} />
                </FontdueSection>
              );
            }
            if (section.sectionType === 'characterViewer' && collectionSlug) {
              return (
                <FontdueSection>
                  <fontdue-character-viewer collection-slug={collectionSlug} />
                </FontdueSection>
              );
            }
            if (section.sectionType === 'buyButton' && collectionId && typefaceName) {
              return (
                <FontdueSection align="content">
                  <HausBuyButton collectionId={collectionId} />
                </FontdueSection>
              );
            }
            if (section.sectionType === 'content' && section.content) {
              return (
                <FontdueSection align="content">
                  <div class="prose max-w-none">
                    <PortableText value={section.content} />
                  </div>
                </FontdueSection>
              );
            }
            return null;
          })}
        </div>
      )}
      {customEmbed && <PageCustomEmbed html={customEmbed} />}
      {ordersIllustrationSrc && (
        <img
          src={ordersIllustrationSrc}
          alt=""
          aria-hidden="true"
          class="orders-page__hauser"
          loading="lazy"
          decoding="async"
          draggable="false"
        />
      )}
    </article>
  </main>
</BaseLayout>

<style>
  :global(.gallery-page .content-segment:last-child) {
    padding-bottom: 0;
  }

  .gallery-page__mosaic {
    margin-top: 3rem;
  }

  @media (min-width: 768px) {
    .gallery-page__mosaic {
      margin-top: 6rem;
    }
  }
</style>
