---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import ContentSegments from '../../components/ContentSegments.astro';
import FontdueSection from '../../components/FontdueSection.astro';
import PortableText from '../../components/PortableText.astro';
import TypefaceHero from '../../components/TypefaceHero.astro';
import { resolveHeaderSvgBottomPadding } from '../../lib/box-padding';
import { sanityImageProjection } from '../../lib/sanity-image';
import { typefaceSlug } from '../../lib/typeface';
import { safeLoadQuery } from '../../sanity/lib/safe-fetch';

type PageSection = {
  _key?: string;
  sectionType: 'typeTester' | 'characterViewer' | 'buyButton' | 'content';
  content?: unknown;
};

const defaultPageSections: PageSection[] = [
  { _key: 'a', sectionType: 'typeTester' },
  { _key: 'c', sectionType: 'characterViewer' },
];

/** Parse dimensions from Sanity asset URLs like `…-750x87.svg`. */
function assetDimensions(url: string): { width: number; height: number } | null {
  const match = url.match(/-(\d+)x(\d+)\.\w+(?:\?|$)/);
  if (!match) return null;
  return { width: Number(match[1]), height: Number(match[2]) };
}

const { slug } = Astro.params;

const { data: typefacesData } = await safeLoadQuery<Array<{
  name: string;
  slug?: { current: string };
  collectionId?: string;
  body?: unknown;
  detailPageTitle?: string | null;
  contentSegments?: Array<{ heading?: string; body?: unknown }> | null;
  pageSections?: PageSection[] | null;
  headerSvg?: { url?: string | null; alt?: string | null } | null;
  headerSvgPadding?: { bottom?: number | null } | null;
}>>({
  query: `*[_type == "typeface"]{
    name,
    slug,
    collectionId,
    body,
    detailPageTitle,
    contentSegments[]{
      layout,
      hideOnMobile,
      heading,
      media ${sanityImageProjection},
      body,
      aside
    },
    pageSections,
    "headerSvg": headerSvg{
      "url": asset->url,
      "alt": alt
    },
    headerSvgPadding
  }`,
});

const matched = typefacesData?.find((t) => typefaceSlug(t) === slug);

if (!matched) {
  return Astro.redirect('/404');
}

const font = {
  name: matched.name,
  collectionId: matched.collectionId,
  pageSections: matched.pageSections,
  headerSvg: matched.headerSvg?.url
    ? {
        url: matched.headerSvg.url,
        alt: matched.headerSvg.alt ?? matched.name,
        ...(() => {
          const dims = assetDimensions(matched.headerSvg!.url!);
          return dims ? { width: dims.width, height: dims.height } : {};
        })(),
      }
    : null,
  contentSegments:
    matched.contentSegments?.length
      ? matched.contentSegments
      : matched.body || matched.detailPageTitle
        ? [{ heading: matched.detailPageTitle?.trim() || matched.name, body: matched.body }]
        : [],
};

const pageTitle =
  font.contentSegments[0]?.heading?.trim() || font.name;

const introSegment = font.contentSegments[0];
const extraSegments = font.contentSegments.slice(1);
const headerSvgBottomPadding = resolveHeaderSvgBottomPadding(matched.headerSvgPadding);

const sections: PageSection[] = (
  font.pageSections?.length ? font.pageSections : defaultPageSections
).filter((section) => section.sectionType !== 'buyButton');

const preloadImages = font.headerSvg?.url ? [font.headerSvg.url] : [];
---

<BaseLayout
  title={pageTitle}
  description={`${pageTitle} - Explore and purchase from Haus Type foundry.`}
  buyCollectionId={font.collectionId}
  trialFontsHref="/trial-fonts"
  preloadImages={preloadImages}
>
  <Header />
  <main class="flex-1">
    <TypefaceHero
      segment={introSegment}
      headerSvg={font.headerSvg}
      typefaceName={font.name}
      bottomPadding={headerSvgBottomPadding}
    />

    <div class="typeface-page__body bg-site site-page-body">
      {extraSegments.length > 0 && (
        <ContentSegments segments={extraSegments} />
      )}

      <div class="w-full flex flex-col gap-16">
        {sections.map((section) => {
          if (section.sectionType === 'typeTester') {
            return (
              <FontdueSection>
                <fontdue-type-testers collection-slug={slug} />
              </FontdueSection>
            );
          }
          if (section.sectionType === 'characterViewer') {
            return (
              <FontdueSection>
                <fontdue-character-viewer collection-slug={slug} />
              </FontdueSection>
            );
          }
          if (section.sectionType === 'content' && section.content) {
            return (
              <FontdueSection align="content">
                <div class="prose max-w-none">
                  <PortableText value={section.content} />
                </div>
              </FontdueSection>
            );
          }
          return null;
        })}
      </div>
    </div>
  </main>
</BaseLayout>
