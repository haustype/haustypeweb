---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import HomeMosaic from '../components/HomeMosaic.astro';
import FontsInUseGrid from '../components/FontsInUseGrid.astro';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';
import { fontsInUseCarouselUrlWidth } from '../lib/fonts-in-use-mosaic';
import { homepageQuery, mapHomepageGrid } from '../lib/homepage-grid';
import { cappedSanityImageWidth, type SanityImageValue } from '../lib/sanity-image';
import { urlForImage } from '../sanity/lib/url-for-image';

const { data: homepageData } = await safeLoadQuery<{
  settings?: {
    aboutText?: string;
    aboutPadding?: Parameters<typeof mapHomepageGrid>[4];
    fontsInUse?: Array<{ image?: unknown; alt?: string }>;
    tiles?: Parameters<typeof mapHomepageGrid>[0];
    grid?: Parameters<typeof mapHomepageGrid>[3];
  } | null;
  typefaces?: Parameters<typeof mapHomepageGrid>[2];
} | null>({
  query: homepageQuery,
});

const homepageSettings = homepageData?.settings;

const { data: legacySettings } = await safeLoadQuery<{
  aboutText?: string;
  fontsInUse?: Array<{ image?: unknown; alt?: string }>;
} | null>({
  query: `*[_type == "siteSettings"][0]{
    aboutText,
    fontsInUse
  }`,
});

const aboutText =
  (homepageSettings?.aboutText?.trim() ? homepageSettings.aboutText : null) ??
  (legacySettings?.aboutText?.trim() ? legacySettings.aboutText : null) ??
  '';

const tiles = mapHomepageGrid(
  homepageSettings?.tiles,
  aboutText,
  homepageData?.typefaces,
  homepageSettings?.grid,
  homepageSettings?.aboutPadding,
);

const rawFontsInUse =
  homepageSettings?.fontsInUse?.length
    ? homepageSettings.fontsInUse
    : legacySettings?.fontsInUse ?? [];

const carouselImageWidth = fontsInUseCarouselUrlWidth();

const fontsInUseItems = rawFontsInUse
  .map((item) => {
    if (!item.image) return null;
    const image = item.image as SanityImageValue;
    const width = cappedSanityImageWidth(image, carouselImageWidth);
    return {
      url: urlForImage(image).width(width).auto('format').quality(90).url(),
      alt: item.alt?.trim() || 'Font in use',
    };
  })
  .filter((item): item is { url: string; alt: string } => Boolean(item));
---

<BaseLayout description={aboutText}>
  <Header />
  <main class="bg-site flex-1">
    <article class="site-page-top" data-reveal-stagger="scroll">
      {tiles.length > 0 && <HomeMosaic tiles={tiles} />}
      {fontsInUseItems.length > 0 && <FontsInUseGrid items={fontsInUseItems} />}
    </article>
  </main>
</BaseLayout>
