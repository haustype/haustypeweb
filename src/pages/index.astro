---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import About from '../components/About.astro';
import TypefaceList from '../components/TypefaceList.astro';
import FontsInUseGrid from '../components/FontsInUseGrid.astro';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';
import { typefaceSlug } from '../lib/typeface';
import { urlForImage } from '../sanity/lib/url-for-image';

const fallbackAboutText =
  'Haus Type is a New York–based type foundry creating versatile Latin type for text and display. The studio also takes on selected custom projects in wordmark refinement and bespoke typeface design.';

const fallbackTypefaces = [
  { name: 'Chumbo', slug: 'chumbo' },
  { name: 'Rubrica', slug: 'rubrica' },
  { name: 'Squoze', slug: 'squoze' },
  { name: 'Yeehaw', slug: 'yeehaw' },
];

type TypefaceFromSanity = {
  name: string;
  slug?: { current: string };
  collectionId?: string;
  specimen?: {
    url?: string | null;
    alt?: string | null;
    paddingTop?: number | null;
    paddingBottom?: number | null;
  } | null;
  specimenMobile?: { url?: string | null; alt?: string | null } | null;
  /** @deprecated Legacy top-level fields — coalesced into specimen padding */
  specimenPaddingTop?: number | null;
  specimenPaddingBottom?: number | null;
};

const typefaceProjection = `{
  orderRank,
  name,
  slug,
  collectionId,
  "specimen": coalesce(
    specimen{
      "url": asset->url,
      "alt": alt,
      "paddingTop": coalesce(listPadding.top, 32),
      "paddingBottom": coalesce(listPadding.bottom, 32)
    },
    specimens[0]{
      "url": asset->url,
      "alt": alt,
      "paddingTop": 32,
      "paddingBottom": 32
    }
  ),
  "specimenMobile": specimenMobile{
    "url": asset->url,
    "alt": alt
  },
  specimenPaddingTop,
  specimenPaddingBottom
}`;

const { data: homepageSettings } = await safeLoadQuery<{
  aboutText?: string;
  fontsInUse?: Array<{ image?: unknown; alt?: string }>;
} | null>({
  query: `*[_type == "homepageSettings"][0]{
    aboutText,
    fontsInUse
  }`,
});

const { data: legacySettings } = await safeLoadQuery<{
  aboutText?: string;
  fontsInUse?: Array<{ image?: unknown; alt?: string }>;
} | null>({
  query: `*[_type == "siteSettings"][0]{
    aboutText,
    fontsInUse
  }`,
});

const aboutText =
  (homepageSettings?.aboutText?.trim() ? homepageSettings.aboutText : null) ??
  (legacySettings?.aboutText?.trim() ? legacySettings.aboutText : null) ??
  fallbackAboutText;

const { data: typefacesData } = await safeLoadQuery<TypefaceFromSanity[]>({
  query: `*[_type == "typeface"] | order(orderRank)${typefaceProjection}`,
});

const typefacesFromSanity = (typefacesData ?? []).length > 0;

const typefaces =
  typefacesFromSanity
    ? (typefacesData ?? []).map((t) => ({
        name: t.name,
        slug: typefaceSlug(t) ?? '',
        collectionId: t.collectionId,
        specimen: t.specimen?.url
          ? { url: t.specimen.url, alt: t.specimen.alt ?? undefined }
          : undefined,
        specimenMobile: t.specimenMobile?.url
          ? { url: t.specimenMobile.url, alt: t.specimenMobile.alt ?? undefined }
          : undefined,
        specimenPaddingTop: t.specimen?.paddingTop ?? t.specimenPaddingTop ?? 32,
        specimenPaddingBottom: t.specimen?.paddingBottom ?? t.specimenPaddingBottom ?? 32,
      }))
    : fallbackTypefaces;

const rawFontsInUse =
  homepageSettings?.fontsInUse?.length
    ? homepageSettings.fontsInUse
    : legacySettings?.fontsInUse ?? [];

const fontsInUseItems = rawFontsInUse
  .map((item) => {
    if (!item.image) return null;
    return {
      url: urlForImage(item.image).width(900).quality(85).url(),
      alt: item.alt?.trim() || 'Font in use',
    };
  })
  .filter((item): item is { url: string; alt: string } => Boolean(item));

---

<BaseLayout description={aboutText}>
  <Header />
  <main class="flex-1">
    {import.meta.env.DEV && !typefacesFromSanity && (
      <div class="bg-amber-100 border-b border-amber-300 text-amber-900 px-4 py-2 text-center text-sm">
        Could not load typefaces from Sanity. Showing generic placeholders. Check project id and dataset, and that content is published.
      </div>
    )}
    <About text={aboutText} />
    <TypefaceList typefaces={typefaces} />
    <FontsInUseGrid items={fontsInUseItems} />
  </main>
</BaseLayout>
