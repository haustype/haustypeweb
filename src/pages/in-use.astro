---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContentSegments, { type ContentSegment } from '../components/ContentSegments.astro';
import FontsInUseMosaic, {
  type FontsInUseMosaicItem,
} from '../components/FontsInUseMosaic.astro';
import { sanityImageProjection } from '../lib/sanity-image';
import { inUseImageUrlWidth, resolveInUseImageWidth } from '../lib/fonts-in-use-mosaic';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';
import { urlForImage } from '../sanity/lib/url-for-image';

const contentSegmentProjection = `{
  layout,
  heading,
  media ${sanityImageProjection},
  body,
  aside
}`;

const inUseItemProjection = `{
  alt,
  caption,
  width,
  typeface->{
    name,
    slug
  },
  image {
    asset,
    crop,
    hotspot
  }
}`;

const defaultTitle = 'In Use';
const defaultDescription = 'See our fonts in client projects.';

let title = defaultTitle;
let description = defaultDescription;
let contentSegments: ContentSegment[] = [];
let mosaicItems: FontsInUseMosaicItem[] = [];

const { data: page } = await safeLoadQuery<{
  title: string;
  description?: string;
  body?: unknown;
  contentSegments?: ContentSegment[] | null;
  inUseGallery?: Array<{
    alt?: string;
    caption?: string;
    width?: string;
    typeface?: {
      name?: string;
      slug?: { current?: string };
    } | null;
    image?: {
      asset?: { _ref?: string };
      crop?: unknown;
      hotspot?: unknown;
    };
  }> | null;
} | null>({
  query: `*[_type == "page" && slug.current == "in-use"][0]{
    title,
    description,
    body,
    contentSegments[]${contentSegmentProjection},
    inUseGallery[]${inUseItemProjection}
  }`,
});

if (page) {
  title = page.title;
  description = page.description ?? defaultDescription;
  contentSegments =
    page.contentSegments?.length
      ? page.contentSegments
      : page.body
        ? [{ heading: page.title, body: page.body }]
        : [];
}

const rawItems = page?.inUseGallery ?? [];

mosaicItems = rawItems
  .map((item) => {
    if (!item.image?.asset) return null;

    const imageWidth = resolveInUseImageWidth(item.width);
    const typefaceSlug = item.typeface?.slug?.current?.trim();

    return {
      url: urlForImage(item.image).width(inUseImageUrlWidth(imageWidth)).quality(85).url(),
      alt: item.alt?.trim() || item.caption?.trim() || item.typeface?.name?.trim() || 'Font in use',
      caption: item.caption?.trim() || undefined,
      width: imageWidth,
      typeface:
        typefaceSlug && item.typeface?.name
          ? { name: item.typeface.name, slug: typefaceSlug }
          : undefined,
    };
  })
  .filter((item): item is FontsInUseMosaicItem => Boolean(item));
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="bg-site flex-1">
    <article class="in-use-page w-full pt-24 pb-[160px]">
      {contentSegments.length > 0 && (
        <ContentSegments segments={contentSegments} class="mb-0" />
      )}

      <div class="in-use-page__mosaic">
        <FontsInUseMosaic items={mosaicItems} />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  :global(.in-use-page .content-segment:last-child) {
    padding-bottom: 0;
  }

  .in-use-page__mosaic {
    margin-top: 6rem;
  }
</style>
