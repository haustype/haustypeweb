---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ContentSegments, { type ContentSegment } from '../components/ContentSegments.astro';
import { sanityImageProjection } from '../lib/sanity-image';
import { getCollection } from 'astro:content';
import { safeLoadQuery } from '../sanity/lib/safe-fetch';

const contentSegmentProjection = `{
  layout,
  heading,
  media ${sanityImageProjection},
  body,
  aside
}`;

const defaultTitle = 'Orders';
const defaultDescription = 'Sign in to view your font orders.';

let title = defaultTitle;
let description = defaultDescription;
let contentSegments: ContentSegment[] = [];
let source: 'sanity' | 'astro' | null = null;
let astroContent: { Content: import('astro').MarkdownInstance['Content'] } | null = null;

const { data: page } = await safeLoadQuery<{
  title: string;
  description?: string;
  body?: unknown;
  contentSegments?: ContentSegment[] | null;
} | null>({
  query: `*[_type == "page" && slug.current == "orders"][0]{
    title,
    description,
    body,
    contentSegments[]${contentSegmentProjection}
  }`,
});

if (page) {
  source = 'sanity';
  title = page.title;
  description = page.description ?? defaultDescription;
  contentSegments =
    page.contentSegments?.length
      ? page.contentSegments
      : page.body
        ? [{ heading: page.title, body: page.body }]
        : [];
} else {
  const pages = await getCollection('pages');
  const astroPage = pages.find((entry) => entry.slug === 'orders') ?? null;
  if (astroPage) {
    source = 'astro';
    title = astroPage.data.title;
    description = astroPage.data.description ?? defaultDescription;
    astroContent = await astroPage.render();
  }
}
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="bg-site flex-1">
    <article class="orders-page w-full pt-24 pb-[160px]">
      {source === 'sanity' && contentSegments.length > 0 && (
        <ContentSegments segments={contentSegments} class="mb-0" />
      )}

      {source === 'astro' && astroContent && (
        <div class="site-grid heading-row orders-page__intro w-full max-w-content mx-auto px-8" data-reveal>
          <header class="site-grid__left">
            <h1 class="font-normal text-black">{title}</h1>
          </header>
          <div class="site-grid__right prose max-w-none">
            <astroContent.Content />
          </div>
        </div>
      )}

      <div class="site-grid orders-page__form-grid" data-reveal>
        <div class="orders-page__form col-span-12 md:col-span-5 md:col-start-4">
          <fontdue-customer-login-form></fontdue-customer-login-form>
        </div>
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  :global(.orders-page .content-segment:last-child) {
    padding-bottom: 0;
  }

  .orders-page__form-grid {
    margin-top: 2rem;
  }

  .orders-page__form fontdue-customer-login-form {
    display: block;
    width: 100%;
    max-width: 24rem;
  }
</style>
