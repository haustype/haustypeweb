# Sanity.io – run `npx sanity init --env` to create the project and populate these
PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Fontdue store (optional overrides)
# PUBLIC_FONTDUE_STORE_URL=https://store.haustype.com
# PUBLIC_FONTDUE_UI_FONT_CSS=https://fonts.fontdue.com/bech-type/css/aros-gothic.css
# PUBLIC_FONTDUE_UI_FONT_PRELOAD=https://fonts.fontdue.com/bech-type/fonts/6c2da023c0ff219326b4c41ea2453702fc4bce41.woff2

# Canonical public site URL (no trailing slash).
# Production uses www (apex redirects there). Netlify preview can override.
PUBLIC_SITE_URL=https://www.haustype.com
